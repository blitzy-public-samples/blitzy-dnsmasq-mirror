; DNSSEC-signed zone file for testing
; Domain: dnssec-test.example.
; Purpose: Validate DNSSEC signature verification, trust chain validation,
;          and secure DNS resolution in the Rust dnsmasq implementation
; Algorithm: RSASHA256 (8)
; Zone Signing Key (ZSK) Tag: 12345
; Key Signing Key (KSK) Tag: 54321

$ORIGIN dnssec-test.example.
$TTL 3600

; SOA Record - Start of Authority
@       IN      SOA     ns1.dnssec-test.example. hostmaster.dnssec-test.example. (
                        2024010101      ; Serial (YYYYMMDDNN format)
                        3600            ; Refresh (1 hour)
                        1800            ; Retry (30 minutes)
                        604800          ; Expire (1 week)
                        86400 )         ; Negative TTL (1 day)

; NS Records - Name Servers
@       IN      NS      ns1.dnssec-test.example.
@       IN      NS      ns2.dnssec-test.example.

; A Records - IPv4 Addresses
@       IN      A       192.0.2.1
ns1     IN      A       192.0.2.10
ns2     IN      A       192.0.2.11
www     IN      A       192.0.2.100
mail    IN      A       192.0.2.200

; AAAA Records - IPv6 Addresses
@       IN      AAAA    2001:db8::1
ns1     IN      AAAA    2001:db8::10
www     IN      AAAA    2001:db8::100

; MX Record - Mail Exchanger
@       IN      MX      10 mail.dnssec-test.example.

; TXT Record - Text Data
@       IN      TXT     "v=spf1 mx -all"
@       IN      TXT     "DNSSEC-signed zone for testing"

; DNSKEY Records - Zone Signing Key (ZSK) and Key Signing Key (KSK)
; Algorithm 8 = RSASHA256
; Flags: 256 = ZSK (Zone Signing Key), 257 = KSK (Key Signing Key)

; Zone Signing Key (ZSK) - Used to sign zone data
@       IN      DNSKEY  256 3 8 (
                        AwEAAb8V2KN+3fH8xjQJKPZYGGHQZN9X5qN7Y2Jx8hRmLQp3vXC5
                        rKJ9Tt4eLmVp7xN8gZ2FqR4wJ3mPkN5xL8QvZ3C7yT9BxFp2M6Hq
                        8L5R2V3K9JxT7Y4C1W6P8NzF5M3L2H9Q4S6V8K1T3Y7R2J5N8C4W
                        6X9P1M5H8L3V7K2T4S9Y1Q6R3C8F5N2Z7 ) ; ZSK; alg=8; tag=12345

; Key Signing Key (KSK) - Used to sign DNSKEY RRset
@       IN      DNSKEY  257 3 8 (
                        AwEAAcZ8N3F2xK7L5W9Y1Q3R8T6M4P2H7V5C9S1X8K3T6Y2F4N7J
                        9L5V2C8R3Q1T4W7K6P9M2S5Y8H1F3V6C9Z2X4T7L1N8Q5R3K6W4M
                        7P2H9Y5S1C8F3V6T2L4X9K7Q1N5W3R8J6M4C2P7Y9L5V1H8T3S6K
                        4F2Q9N7X1C5W8R3M6Y4T2L7P5H9J1V8K3S
                        6C4F9Q2X7T5N1W8L3R6M9Y4P2H7V5K1J8C
                        3S6F2T9X4Q7N5W1L8R3M6Y9P2V5H7K4C1J
                        8T6S3F9Q2X5N7W4L1R8M3Y6P9V2H5K7C4F
                        1J8T3S6Q9X2N5W7L4R1M8Y3P6V9H2K5C7F
                        4J1T8S3Q6X9N2W5L7R4M1Y8P3V6H9K2C5 ) ; KSK; alg=8; tag=54321

; RRSIG Records - Resource Record Signatures
; Format: RRSIG <type-covered> <algorithm> <labels> <original-ttl> <sig-expiration> <sig-inception> <key-tag> <signer-name> <signature>

; Signature over SOA record (signed by ZSK)
