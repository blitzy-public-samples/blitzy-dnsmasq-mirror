; Authoritative DNS Zone File for Integration Testing
; This zone file tests the Rust implementation's authoritative DNS server
; functionality including zone transfers, AXFR support, and delegation.
; Validates translation of auth.c to dns/auth module.
;
; Domain: auth-example.com
; Purpose: Comprehensive authoritative zone configuration demonstrating
;          RFC 1035 compliance and advanced DNS features
;
; File Format: BIND zone file format
; Tested Features:
;   - SOA record with proper parameters
;   - Multiple nameserver records with glue
;   - Subdomain delegation
;   - Various resource record types
;   - Zone transfer (AXFR/IXFR) support
;   - DNSSEC-ready structure

$ORIGIN auth-example.com.
$TTL 86400  ; Default TTL: 24 hours

; Start of Authority (SOA) Record
; Format: name ttl class rr primary-ns admin-email serial refresh retry expire minimum
@       IN      SOA     ns1.auth-example.com. hostmaster.auth-example.com. (
                        2024010601  ; Serial number (YYYYMMDDNN format)
                        3600        ; Refresh: 1 hour - secondary checks for updates
                        900         ; Retry: 15 minutes - retry interval on failure
                        604800      ; Expire: 1 week - secondary stops serving if no refresh
                        86400       ; Minimum TTL: 24 hours - negative caching TTL
                        )

; Nameserver Records (NS)
; Multiple NS records demonstrate redundancy and proper zone authority
@       IN      NS      ns1.auth-example.com.
@       IN      NS      ns2.auth-example.com.
@       IN      NS      ns3.auth-example.com.

; Glue Records for Nameservers
; A and AAAA records for nameservers in the same zone
; These are required to prevent circular dependencies during resolution
ns1     IN      A       192.0.2.1
ns1     IN      AAAA    2001:db8:1::1
ns2     IN      A       192.0.2.2
ns2     IN      AAAA    2001:db8:1::2
ns3     IN      A       192.0.2.3
ns3     IN      AAAA    2001:db8:1::3

; Main Domain Records
@       IN      A       192.0.2.10
@       IN      AAAA    2001:db8:1::10
www     IN      A       192.0.2.11
www     IN      AAAA    2001:db8:1::11

; Mail Exchange Records (MX)
; Priority values: lower number = higher priority
@       IN      MX      10 mail1.auth-example.com.
@       IN      MX      20 mail2.auth-example.com.
@       IN      MX      30 mail3.auth-example.com.

; Mail Server A Records
mail1   IN      A       192.0.2.20
mail1   IN      AAAA    2001:db8:1::20
mail2   IN      A       192.0.2.21
mail2   IN      AAAA    2001:db8:1::21
mail3   IN      A       192.0.2.22
mail3   IN      AAAA    2001:db8:1::22

; Canonical Name Records (CNAME)
; Aliases pointing to canonical names
ftp     IN      CNAME   www.auth-example.com.
webmail IN      CNAME   www.auth-example.com.
smtp    IN      CNAME   mail1.auth-example.com.
imap    IN      CNAME   mail1.auth-example.com.

; Text Records (TXT)
; SPF record for email authentication
@       IN      TXT     "v=spf1 mx a:mail1.auth-example.com a:mail2.auth-example.com -all"
; Domain verification record
@       IN      TXT     "auth-example-verification=a1b2c3d4e5f6"
; DMARC policy record
_dmarc  IN      TXT     "v=DMARC1; p=quarantine; rua=mailto:dmarc@auth-example.com"

; Service Records (SRV)
; Format: _service._proto.name. TTL class SRV priority weight port target.
_ldap._tcp      IN      SRV     10 60 389 ldap.auth-example.com.
_kerberos._tcp  IN      SRV     10 60 88  kerberos.auth-example.com.
_xmpp-client._tcp IN    SRV     10 60 5222 xmpp.auth-example.com.
_xmpp-server._tcp IN    SRV     10 60 5269 xmpp.auth-example.com.

; Service Host Records
ldap    IN      A       192.0.2.30
ldap    IN      AAAA    2001:db8:1::30
kerberos IN     A       192.0.2.31
kerberos IN     AAAA    2001:db8:1::31
xmpp    IN      A       192.0.2.32
xmpp    IN      AAAA    2001:db8:1::32

; Subdomain for Testing
test    IN      A       192.0.2.100
test    IN      AAAA    2001:db8:1::100

; Wildcard Record
; Matches any subdomain not explicitly defined
*.wildcard IN   A       192.0.2.199

; Subdomain Delegation
; Delegate sub.auth-example.com to separate nameservers
sub     IN      NS      ns1.sub.auth-example.com.
sub     IN      NS      ns2.sub.auth-example.com.

; Glue Records for Delegated Subdomain
; Required when delegated NS records are within the delegated zone
ns1.sub IN      A       192.0.2.50
ns1.sub IN      AAAA    2001:db8:2::1
ns2.sub IN      A       192.0.2.51
ns2.sub IN      AAAA    2001:db8:2::2

; Another Delegation Example (out-of-zone nameservers)
; No glue records needed as NS records are external
external-sub IN NS      ns1.example.net.
external-sub IN NS      ns2.example.net.

; Reverse DNS Delegation (for IPv4)
; Delegate reverse DNS zone for 192.0.2.0/24 subnet
; This would typically be in a separate zone file but shown here for completeness
; Note: Actual reverse zone would be in 2.0.192.in-addr.arpa zone

; IPv6 Reverse DNS Delegation (for 2001:db8:1::/48)
; Would be in 1.0.0.0.8.b.d.0.1.0.0.2.ip6.arpa zone

; Additional Service Records for Testing
api     IN      A       192.0.2.40
api     IN      AAAA    2001:db8:1::40
cdn     IN      CNAME   cdn.cloudprovider.example.
vpn     IN      A       192.0.2.41
vpn     IN      AAAA    2001:db8:1::41

; Geographic-based Records (testing multiple A records)
geo     IN      A       192.0.2.60
geo     IN      A       192.0.2.61
geo     IN      A       192.0.2.62
geo     IN      AAAA    2001:db8:1::60
geo     IN      AAAA    2001:db8:1::61
geo     IN      AAAA    2001:db8:1::62

; CAA Records for Certificate Authority Authorization
; Restricts which CAs can issue certificates for this domain
@       IN      CAA     0 issue "letsencrypt.org"
@       IN      CAA     0 issuewild "letsencrypt.org"
@       IN      CAA     0 iodef "mailto:security@auth-example.com"

; PTR Record Example (for reverse DNS within forward zone - unusual but valid)
; Actual PTR records would typically be in reverse zones

; NAPTR Records for ENUM/SIP
; Format: order preference flags service regexp replacement
_enum   IN      NAPTR   10 100 "u" "E2U+sip" "!^.*$!sip:info@auth-example.com!" .

; SSHFP Records (SSH Fingerprints)
; Format: algorithm fp-type fingerprint
@       IN      SSHFP   1 1 abcdef0123456789abcdef0123456789abcdef01
@       IN      SSHFP   2 1 fedcba9876543210fedcba9876543210fedcba98

; TLSA Records for DANE (DNS-Based Authentication of Named Entities)
; Format: usage selector matching-type certificate-data
_443._tcp IN    TLSA    3 1 1 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

; LOC Record (Geographic Location)
; Format: degrees minutes seconds N/S degrees minutes seconds E/W altitude size horizontal vertical
@       IN      LOC     37 23 30.900 N 121 59 19.000 W 6.00m 100m 100m 10m

; Testing Records for Various TTL Values
short-ttl IN    300 A   192.0.2.150  ; 5-minute TTL
long-ttl  IN    604800 A 192.0.2.151 ; 1-week TTL

; HINFO Record (Host Information) - Historical, rarely used
legacy  IN      HINFO   "Intel Xeon" "Linux"

; RP Record (Responsible Person)
@       IN      RP      hostmaster.auth-example.com. .

; End of Zone File
; This comprehensive zone file validates:
; - SOA record parsing with all parameters
; - Multiple NS records and glue record handling
; - Subdomain delegation with both in-zone and out-of-zone NS
; - Various RR types (A, AAAA, CNAME, MX, TXT, SRV, CAA, etc.)
; - Zone transfer support (AXFR/IXFR)
; - RFC 1035 compliance
; - Proper TTL handling (default and per-record)
; - Wildcard record support
; - Service discovery records
; - Security-related records (CAA, TLSA, SSHFP)
