# Static IP Mapping Lease Database Fixture
# This fixture contains leases for statically configured hosts with reserved addresses
# via dhcp-host configuration directives. Tests interaction between DHCP leases and
# static host configurations, including infinite lease times and configured hostnames.
#
# Format: DHCPv4: <expiry> <hw_addr> <ip_addr> <hostname|*> <client_id|*>
#         DHCPv6: duid <hex_duid>
#                 <expiry> [T]<iaid> <ipv6_addr> <hostname|*> <client_id|*>
#
# Static leases use:
# - Very large expiry timestamps (4294967295 = 0xFFFFFFFF for 2038 overflow, or far-future)
# - Hardware addresses from dhcp-host MAC specifications
# - IP addresses from static reservation ranges
# - Hostnames from dhcp-host name= parameters (override DHCP-supplied names)
#
# Tests verify:
# - Static lease identification (infinite expiry handling per lease_set_expires())
# - Hostname override from configs (find_config() integration)
# - Static lease preservation during pruning
# - Configured vs dynamic lease conflict resolution
# - lease_update_from_configs() application of static reservations

# DHCPv4 Static Mappings
# ====================

# Static mapping with 2038 overflow timestamp (0xFFFFFFFF = 4294967295)
# Ethernet MAC, reserved IP, configured hostname, no client ID
# Simulates: dhcp-host=aa:bb:cc:dd:ee:ff,192.168.1.10,server1
4294967295 aa:bb:cc:dd:ee:ff 192.168.1.10 server1 *

# Static mapping with far-future timestamp (year 2147483647 seconds from epoch)
# Tests very long lease times for static reservations
# Simulates: dhcp-host=11:22:33:44:55:66,192.168.1.11,workstation1,infinite
2147483647 11:22:33:44:55:66 192.168.1.11 workstation1 *

# Static mapping with explicit hardware type (0x01 = Ethernet)
# Tests non-default hardware type handling in static leases
# Simulates: dhcp-host=01:aa:bb:cc:dd:ee:01,192.168.1.12,printer1
4294967295 01-aa:bb:cc:dd:ee:01 192.168.1.12 printer1 *

# Static mapping with Token Ring hardware type (0x06)
# Tests platform-specific hardware types in static configurations
# Simulates: dhcp-host=06:aa:bb:cc:dd:ee:02,192.168.1.13,tokenring1
4294967295 06-aa:bb:cc:dd:ee:02 192.168.1.13 tokenring1 *

# Static mapping with client identifier
# Tests static lease with both MAC and client ID
# Simulates: dhcp-host=aa:bb:cc:dd:ee:03,192.168.1.14,laptop1,id:01:aa:bb:cc:dd:ee:03
4294967295 aa:bb:cc:dd:ee:03 192.168.1.14 laptop1 01:aa:bb:cc:dd:ee:03

# Static mapping with complex client identifier
# Tests client ID with non-MAC format (e.g., string-based client ID)
# Simulates: dhcp-host=id:63:6c:69:65:6e:74:31,192.168.1.15,device1
4294967295 aa:bb:cc:dd:ee:04 192.168.1.15 device1 63:6c:69:65:6e:74:31

# Static mapping with FQDN hostname
# Tests fully-qualified domain name in static configuration
# Simulates: dhcp-host=aa:bb:cc:dd:ee:05,192.168.1.16,server.example.com
4294967295 aa:bb:cc:dd:ee:05 192.168.1.16 server.example.com *

# Static mapping with underscores in hostname
# Tests hostname validation with non-standard but commonly used characters
# Simulates: dhcp-host=aa:bb:cc:dd:ee:06,192.168.1.17,test_server_01
4294967295 aa:bb:cc:dd:ee:06 192.168.1.17 test_server_01 *

# Static mapping with no hostname (wildcard)
# Tests static IP without hostname override
# Simulates: dhcp-host=aa:bb:cc:dd:ee:07,192.168.1.18
4294967295 aa:bb:cc:dd:ee:07 192.168.1.18 * *

# Static mapping with 48-bit MAC (full Ethernet address)
# Standard Ethernet MAC address format
# Simulates: dhcp-host=00:11:22:33:44:55,192.168.1.20,desktop1
4294967295 00:11:22:33:44:55 192.168.1.20 desktop1 *

# Static mapping demonstrating hostname override behavior
# This lease should override any DHCP-supplied hostname per lease_update_from_configs()
# Simulates configured hostname taking precedence over client-supplied name
# Simulates: dhcp-host=aa:bb:cc:dd:ee:08,192.168.1.21,configured-name
4294967295 aa:bb:cc:dd:ee:08 192.168.1.21 configured-name *

# Static mapping in different subnet
# Tests static leases across multiple DHCP ranges
# Simulates: dhcp-host=aa:bb:cc:dd:ee:09,10.0.0.10,remote-server
4294967295 aa:bb:cc:dd:ee:09 10.0.0.10 remote-server *

# Static mapping with maximum expiry value
# Tests edge case of maximum 32-bit unsigned integer timestamp
# Simulates: dhcp-host=aa:bb:cc:dd:ee:0a,192.168.1.22,max-expiry-host
4294967295 aa:bb:cc:dd:ee:0a 192.168.1.22 max-expiry-host *

# DHCPv6 Static Mappings
# ====================

# DUID (DHCP Unique Identifier) for DHCPv6 server
# Format: duid <hex_bytes_colon_separated>
# This DUID represents the server's identifier used in DHCPv6 transactions
duid 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:ff

# DHCPv6 Static mapping with NA (Non-Temporary Address)
# Infinite lease (2038 overflow value), IAID=1000, static IPv6 address
# Simulates: dhcp-host=id:00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:01,[2001:db8::10],server1-v6
4294967295 1000 2001:db8::10 server1-v6 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:01

# DHCPv6 Static mapping with TA (Temporary Address)
# Tests temporary address assignment with static configuration
# Simulates: dhcp-host=id:00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:02,[2001:db8::20],temp-host,ta
4294967295 T2000 2001:db8::20 temp-host 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:02

# DHCPv6 Static mapping with far-future expiry
# Tests very long lease duration for IPv6 static reservations
# Simulates: dhcp-host=[2001:db8::30],workstation1-v6,infinite
2147483647 3000 2001:db8::30 workstation1-v6 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:03

# DHCPv6 Static mapping with FQDN
# Tests fully-qualified domain names in DHCPv6 static configuration
# Simulates: dhcp-host=id:00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:04,[2001:db8::40],server.example.com
4294967295 4000 2001:db8::40 server.example.com 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:04

# DHCPv6 Static mapping without hostname
# Tests static IPv6 address without hostname override
# Simulates: dhcp-host=[2001:db8::50]
4294967295 5000 2001:db8::50 * 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:05

# DHCPv6 Static mapping with different prefix
# Tests static leases in alternate IPv6 prefix
# Simulates: dhcp-host=[fd00::100],local-server
4294967295 6000 fd00::100 local-server 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:06

# DHCPv6 Static mapping demonstrating hostname override
# Configured hostname should override client-supplied name per lease_update_from_configs()
# Simulates: dhcp-host=id:00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:07,[2001:db8::60],configured-v6-name
4294967295 7000 2001:db8::60 configured-v6-name 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:07

# DHCPv6 Static TA (Temporary Address) without hostname
# Tests temporary address static mapping
# Simulates: dhcp-host=[2001:db8::70],ta
4294967295 T8000 2001:db8::70 * 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:08

# DHCPv6 Static mapping with link-local prefix
# Tests static lease with link-local IPv6 address (uncommon but valid)
# Simulates: dhcp-host=[fe80::1],link-local-device
4294967295 9000 fe80::1 link-local-device 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:09

# DHCPv6 Static mapping with maximum expiry
# Tests edge case of maximum timestamp for IPv6 static lease
# Simulates: dhcp-host=[2001:db8::80],max-expiry-v6
4294967295 10000 2001:db8::80 max-expiry-v6 00:01:00:01:2a:3b:4c:5d:aa:bb:cc:dd:ee:0a

# Mixed configuration: Static leases alongside potential dynamic ranges
# These entries demonstrate that static leases coexist with dynamic DHCP
# and maintain their infinite/very-long expiry times through lease pruning
# and database updates via lease_update_from_configs()

# Additional DHCPv4 static mappings for comprehensive testing
# =========================================================

# Static mapping with MAC address vendor prefix (Dell)
# Tests real-world vendor MAC patterns
# Simulates: dhcp-host=d0:67:e5:12:34:56,192.168.1.30,dell-server
4294967295 d0:67:e5:12:34:56 192.168.1.30 dell-server *

# Static mapping with MAC address vendor prefix (Cisco)
# Tests another real-world vendor pattern
# Simulates: dhcp-host=00:1e:14:ab:cd:ef,192.168.1.31,cisco-switch
4294967295 00:1e:14:ab:cd:ef 192.168.1.31 cisco-switch *

# Static mapping with hyphenated hostname
# Tests hostname parsing with hyphens
# Simulates: dhcp-host=aa:bb:cc:dd:ee:10,192.168.1.32,test-server-02
4294967295 aa:bb:cc:dd:ee:10 192.168.1.32 test-server-02 *

# Static mapping demonstrating conflict resolution
# This lease has both MAC and client ID for precise identification
# Simulates: dhcp-host=aa:bb:cc:dd:ee:11,id:01:aa:bb:cc:dd:ee:11,192.168.1.33,conflict-test
4294967295 aa:bb:cc:dd:ee:11 192.168.1.33 conflict-test 01:aa:bb:cc:dd:ee:11

# Static mapping with numeric hostname
# Tests hostnames that are purely numeric (valid but uncommon)
# Simulates: dhcp-host=aa:bb:cc:dd:ee:12,192.168.1.34,12345
4294967295 aa:bb:cc:dd:ee:12 192.168.1.34 12345 *

# End of static mappings lease database
# Tests should verify:
# 1. All leases recognized as static (expiry >= 2038 overflow or very large values)
# 2. Hostnames from configuration override any client-supplied names
# 3. Static leases preserved during lease_prune() operations
# 4. Proper handling of both DHCPv4 and DHCPv6 static reservations
# 5. find_config() integration to match hardware addresses and client IDs
# 6. lease_update_from_configs() correctly applies static configurations
# 7. Infinite/very-long lease time handling in lease_set_expires() with 2038 considerations
